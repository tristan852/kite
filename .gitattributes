# ========================
# Text files - normalize to LF in repo
# Git will convert to CRLF on checkout if needed (Windows)
# ========================

*.txt text eol=lf

# Gradle & Kotlin build scripts
*.gradle text eol=lf
*.gradle.kts text eol=lf

# Java and Kotlin source
*.java text eol=lf
*.kt text eol=lf

# Shell scripts
*.sh text eol=lf

# Configuration & properties
*.properties text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Markdown, LICENSE, README
*.md text eol=lf
LICENSE text eol=lf

# ========================
# Binary files - do not change line endings
# ========================

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary

# IntelliJ project/module files
*.iml binary

# ========================
# Optional: treat all other text as auto
# ========================
* text=auto
